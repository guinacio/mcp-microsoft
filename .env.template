# --- Single-account mode (quick start) ---
MS365_CLIENT_ID=             # Azure App Registration client ID (required for single-account)
MS365_CREDENTIALS_DIR=       # Optional: path for token cache (default: ~/.sentinel/microsoft-mcp/)

# Legacy aliases (still work as fallback):
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CREDENTIALS_DIR=

# --- Multi-account mode ---
# For multiple Microsoft 365 accounts, create a profiles.json file at:
#   ~/.sentinel/microsoft-mcp/profiles.json
#
# Example:
# {
#   "default_profile": "personal",
#   "profiles": {
#     "personal": {
#       "client_id": "your-personal-app-client-id",
#       "tenant_id": "common"
#     },
#     "work": {
#       "client_id": "your-work-app-client-id",
#       "tenant_id": "your-company.onmicrosoft.com"
#     }
#   }
# }
#
# When profiles.json exists, MS365_CLIENT_ID is ignored.
# Each profile gets its own token cache (msal_cache_{name}.json).
# Use the profile management tools (list_ms_profiles, add_ms_profile, etc.)
# or pass profile="name" to any tool to target a specific account.
