# --- mcp-microsoft configuration ---
MS365_CREDENTIALS_DIR=       # Optional: path for token/profile storage (default: ~/.microsoft-mcp/)

# --- Profile setup ---
# Profiles are managed via the profile tools (add_ms_profile, list_ms_profiles, etc.)
# or by creating a profiles.json file at:
#   ~/.microsoft-mcp/profiles.json
#
# Example profiles.json:
# {
#   "default_profile": "personal",
#   "profiles": {
#     "personal": {
#       "client_id": "your-personal-app-client-id",
#       "tenant_id": "common"
#     },
#     "work": {
#       "client_id": "your-work-app-client-id",
#       "tenant_id": "your-company.onmicrosoft.com"
#     }
#   }
# }
#
# Each profile gets its own token cache (msal_cache_{name}.bin, OS-encrypted).
# Pass profile="name" to any tool to target a specific account.

# =============================================================================
# --- Remote server (http) mode ---
# =============================================================================
# Everything below is ONLY read when MCP_TRANSPORT=http. stdio mode (the
# section above — MCPB/Claude Desktop, run from source) ignores all of it.
#
# http mode is a separate deployment model: instead of one local profile per
# server process, any number of users connect over Streamable HTTP and each
# authenticates with their OWN Microsoft work/school account via Entra ID
# OAuth. Every Graph call then runs under that user's delegated identity via
# an On-Behalf-Of token exchange — there is no server-side profile to
# configure. Personal Microsoft accounts (Outlook.com/Live) are not
# supported in http mode; use stdio for those.
#
# See docs/azure-setup.md ("App registration for the remote (http) server")
# for how to create the required Azure App Registration, and README.md's
# "Remote server — multi-user (Streamable HTTP)" section for the full
# picture (quickstart, client connection, security notes).

# Selects the transport. Must be "stdio" (default) or "http".
MCP_TRANSPORT=http

# Host/port the Streamable HTTP server binds to *inside* its process/container.
# 127.0.0.1 is safe for local testing; behind Docker/a reverse proxy you
# typically want 0.0.0.0 so the proxy can reach it (the proxy is then what's
# actually exposed to the internet — see docker-compose.yml).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# The PUBLIC https:// URL this server is reachable at from the outside —
# i.e. your reverse proxy's URL, not the bind address above. Required in
# http mode; startup aborts if missing. Must exactly match (scheme, host,
# port, path) what you register as the redirect URI base in Azure and what
# MCP clients are given, or the OAuth flow and JWT audience/issuer checks
# will fail. Example: https://mcp.example.com
MCP_BASE_URL=

# Azure App Registration for the remote server — a CONFIDENTIAL client (Web
# platform + client secret), separate from any public-client registration
# used for stdio mode. See docs/azure-setup.md. All three are required in
# http mode; startup aborts if any is missing.
MCP_AUTH_CLIENT_ID=
MCP_AUTH_CLIENT_SECRET=
# Your directory's tenant GUID (8-4-4-4-12 hex) — work/school tenants only.
# Copy the Directory (tenant) ID from Azure Portal -> Microsoft Entra ID ->
# Overview. Pseudo-tenants ("organizations", "common", "consumers") and
# verified domains ("contoso.onmicrosoft.com") are REJECTED at startup:
# fastmcp's AzureProvider validates the token "iss" claim against a single
# literal issuer URL built from this value, and real Entra tokens always carry
# the concrete tenant GUID, so a pseudo-tenant/domain never matches. (OBO is
# also not reliably supported for personal Microsoft accounts.) Multi-tenant is
# future work (needs issuer-skip + per-tenant OBO authority).
MCP_AUTH_TENANT_ID=

# The custom API scope name exposed under "Expose an API" in the App
# Registration (Application ID URI api://{client_id} + this scope). MCP
# clients must request it to call any tool. Defaults to "mcp-access" if unset.
MCP_AUTH_REQUIRED_SCOPE=mcp-access

# Stateless Streamable HTTP (no server-side session affinity needed between
# requests from the same client) — set to true only if you have a specific
# horizontal-scaling reason to; note the single-worker constraint below
# still applies regardless of this flag. Defaults to false.
MCP_HTTP_STATELESS=false

# Per-user requests/second ceiling enforced by our bounded per-user (tid+oid)
# token-bucket rate limiter (burst = 2x this value, mirroring fastmcp's
# default). Defaults to 10. Set to 0 or a negative number to disable rate
# limiting entirely. NOTE: this covers authenticated MCP tool traffic to /mcp
# only (keyed per user; per-user state is LRU-capped and idle-pruned so it
# stays bounded). The unauthenticated OAuth endpoints (/authorize, /token,
# /register, /auth/callback) are NOT covered — throttle those at your reverse
# proxy.
MCP_RATE_LIMIT_RPS=10

# NOTE on scaling: the OAuth-proxy client store and the per-user OBO
# credential cache are both in-memory inside this process. Run exactly ONE
# worker process. Horizontal scaling requires wiring fastmcp's external
# `client_storage` backend (not implemented here) — see README.md's
# Security notes for details.

# Observability (DevOps metrics) — OFF by default. Leave EMPTY to disable:
# the /metrics (Prometheus), /stats (JSON), and /dashboard (HTML) routes are
# then not registered at all. Set it to a non-empty secret to enable them;
# callers must present it as `Authorization: Bearer <token>` or as the HTTP
# Basic password (any username). Metrics are in-memory and reset on restart,
# and cover only this single worker. There are no per-user Prometheus label
# series (unbounded cardinality); per-user detail is in /stats and /dashboard.
# Treat these routes as sensitive and additionally restrict them at your
# reverse proxy if the server is internet-facing. See README.md's
# "Observability" subsection. The token itself is never logged.
MCP_STATS_TOKEN=
