# --- mcp-microsoft configuration ---
MS365_CREDENTIALS_DIR=       # Optional: path for token/profile storage (default: ~/.microsoft-mcp/)

# Optional: IANA timezone (e.g. America/Sao_Paulo) for calendar datetimes given
# without an offset when a tool call names no timezone. Unset = such calls are
# rejected instead of silently treated as UTC. Read in both stdio and http mode.
MCP_DEFAULT_TIMEZONE=

# --- Profile setup ---
# Profiles are managed via the profile tools (add_ms_profile, list_ms_profiles, etc.)
# or by creating a profiles.json file at:
#   ~/.microsoft-mcp/profiles.json
#
# Example profiles.json:
# {
#   "default_profile": "personal",
#   "profiles": {
#     "personal": {
#       "client_id": "your-personal-app-client-id",
#       "tenant_id": "common"
#     },
#     "work": {
#       "client_id": "your-work-app-client-id",
#       "tenant_id": "your-company.onmicrosoft.com"
#     }
#   }
# }
#
# Each profile gets its own token cache (msal_cache_{name}.bin, OS-encrypted).
# Pass profile="name" to any tool to target a specific account.

# =============================================================================
# --- Remote server (http) mode ---
# =============================================================================
# Everything below is ONLY read when MCP_TRANSPORT=http. stdio mode (the
# section above — MCPB/Claude Desktop, run from source) ignores all of it.
#
# http mode is a separate deployment model: instead of one local profile per
# server process, any number of users connect over Streamable HTTP and each
# authenticates with their OWN Microsoft account via Entra ID OAuth. Every
# Graph call then runs under that user's delegated identity via an
# On-Behalf-Of token exchange — there is no server-side profile to
# configure. One server serves one account audience: a single work/school
# tenant, or personal Microsoft accounts (Outlook.com/Live) — see
# MCP_AUTH_TENANT_ID below.
#
# See docs/azure-setup.md ("App registration for the remote (http) server")
# for how to create the required Azure App Registration, and README.md's
# "Remote server — multi-user (Streamable HTTP)" section for the full
# picture (quickstart, client connection, security notes).

# Selects the transport. Must be "stdio" (default) or "http".
MCP_TRANSPORT=http

# Host/port the Streamable HTTP server binds to *inside* its process/container.
# 127.0.0.1 is safe for local testing; behind Docker/a reverse proxy you
# typically want 0.0.0.0 so the proxy can reach it (the proxy is then what's
# actually exposed to the internet — see docker-compose.yml).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# The PUBLIC https:// URL this server is reachable at from the outside —
# i.e. your reverse proxy's URL, not the bind address above. Required in
# http mode; startup aborts if missing. Must exactly match (scheme, host,
# port, path) what you register as the redirect URI base in Azure and what
# MCP clients are given, or the OAuth flow and JWT audience/issuer checks
# will fail. Example: https://mcp.example.com
MCP_BASE_URL=

# Azure App Registration for the remote server — a CONFIDENTIAL client (Web
# platform), separate from any public-client registration used for stdio
# mode. See docs/azure-setup.md. MCP_AUTH_CLIENT_ID and MCP_AUTH_TENANT_ID are
# always required in http mode; MCP_AUTH_CLIENT_SECRET only when
# MCP_AUTH_CREDENTIAL_TYPE=secret (the default). Startup aborts otherwise.
MCP_AUTH_CLIENT_ID=
MCP_AUTH_CLIENT_SECRET=
# A concrete tenant GUID (8-4-4-4-12 hex), which also fixes who can sign in:
#   work/school accounts  your Directory (tenant) ID from Azure Portal ->
#                         Microsoft Entra ID -> Overview
#   personal accounts     9188040d-6c67-4c5b-b112-36a304b66dad (the fixed tenant
#                         every Outlook.com/Live account signs in through)
# Pseudo-tenants ("organizations", "common", "consumers") and verified domains
# ("contoso.onmicrosoft.com") are REJECTED at startup: fastmcp's AzureProvider
# validates the token "iss" claim against a single literal issuer URL built
# from this value, and real tokens always carry the concrete tenant GUID, so a
# pseudo-tenant/domain never matches. For the same reason one server cannot
# serve both audiences; run a second instance. Multi-tenant is future work
# (needs issuer-skip + per-tenant OBO authority).
MCP_AUTH_TENANT_ID=

# The custom API scope name exposed under "Expose an API" in the App
# Registration (Application ID URI api://{client_id} + this scope). MCP
# clients must request it to call any tool. Defaults to "mcp-access" if unset.
MCP_AUTH_REQUIRED_SCOPE=mcp-access

# How this server authenticates ITSELF to Entra (code redemption, refresh, and
# the On-Behalf-Of exchange). Default "secret" uses MCP_AUTH_CLIENT_SECRET.
# Production should prefer a secretless credential (leave the secret unset):
#   certificate        PEM with RSA private key + the cert uploaded to the app
#                      registration (MCP_AUTH_CLIENT_CERTIFICATE_PATH[_PASSWORD])
#   managed_identity   Azure managed identity registered as a federated
#                      identity credential on the app (optionally
#                      MCP_AUTH_MANAGED_IDENTITY_CLIENT_ID for a user-assigned one)
#   workload_identity  projected federated token file, e.g. AKS workload
#                      identity (MCP_AUTH_FEDERATED_TOKEN_FILE, falls back to
#                      AZURE_FEDERATED_TOKEN_FILE)
# Secretless types REQUIRE MCP_AUTH_JWT_SIGNING_KEY. See docs/DEVOPS_GUIDE.md.
MCP_AUTH_CREDENTIAL_TYPE=secret
MCP_AUTH_CLIENT_CERTIFICATE_PATH=
MCP_AUTH_CLIENT_CERTIFICATE_PASSWORD=
MCP_AUTH_MANAGED_IDENTITY_CLIENT_ID=
MCP_AUTH_FEDERATED_TOKEN_FILE=

# Signs the MCP tokens this server issues to clients and keys its encrypted
# OAuth state. Strongly recommended for every deployment: without it the key is
# derived from the client secret, so rotating the secret signs everyone out.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MCP_AUTH_JWT_SIGNING_KEY=

# Optional shared OAuth state (client registrations, upstream refresh tokens)
# so sign-ins survive restarts and are shared by replicas. Requires the
# [redis] extra and a Fernet key; state is always encrypted at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_AUTH_REDIS_URL=
MCP_AUTH_STORAGE_ENCRYPTION_KEY=

# Comma-separated allow-list of MCP client redirect URIs (fnmatch wildcards).
# Unset = any redirect URI is accepted and the consent screen is the only
# guard. Example: https://claude.ai/api/mcp/auth_callback,http://localhost:*,http://127.0.0.1:*
MCP_AUTH_ALLOWED_REDIRECT_URIS=

# Entra authority host. Sovereign clouds: login.microsoftonline.us (US Gov),
# login.chinacloudapi.cn (China). Defaults to login.microsoftonline.com.
MCP_AUTH_AUTHORITY_HOST=login.microsoftonline.com

# MCP 2026-07-28 confirmations (confirm=True) round-trip a sealed request
# state through the client. One worker needs nothing; replicas behind a load
# balancer must share these comma-separated keys (>= 32 bytes each; first key
# seals, all keys unseal, so rotate by prepending a new key).
MCP_REQUEST_STATE_KEYS=

# Stateless Streamable HTTP (no server-side session affinity needed between
# requests from the same client) — set to true only if you have a specific
# horizontal-scaling reason to; note the single-worker constraint below
# still applies regardless of this flag. Defaults to false.
MCP_HTTP_STATELESS=false

# Per-user requests/second ceiling enforced by our bounded per-user (tid+oid)
# token-bucket rate limiter (burst = 2x this value, mirroring fastmcp's
# default). Defaults to 10. Set to 0 or a negative number to disable rate
# limiting entirely. NOTE: this covers authenticated MCP tool traffic to /mcp
# only (keyed per user; per-user state is LRU-capped and idle-pruned so it
# stays bounded). The unauthenticated OAuth endpoints (/authorize, /token,
# /register, /auth/callback) are NOT covered — throttle those at your reverse
# proxy.
MCP_RATE_LIMIT_RPS=10

# No-delete server: when truthy ("1", "true", "yes", "on"), the permanent-
# delete tools (delete_email, bulk_delete_emails, delete_event, delete_contact,
# delete_folder, delete_drive_item, delete_list_item) are never registered —
# no connected user can hard-delete anything. Recoverable variants
# (trash_email, bulk_trash_emails, move_or_copy_item) stay available. Applies
# to BOTH modes and to ALL users of an http server (server-wide, not
# per-user); to serve both audiences, run a second no-delete instance — see
# docker-compose.yml's commented mcp-microsoft-nodelete service and the
# DevOps guide's "No-delete deployment" section.
MCP_DISABLE_DELETION_TOOLS=

# NOTE on scaling: the OAuth-proxy client store and the per-user OBO
# credential cache are both in-memory inside this process. Run exactly ONE
# worker process. Horizontal scaling requires wiring fastmcp's external
# `client_storage` backend (not implemented here) — see README.md's
# Security notes for details.

# Logging level for the server process (DEBUG, INFO, WARNING, ERROR). Leave
# EMPTY for the default: INFO in http mode (so the per-call audit log —
# `tool_call tool=... oid=... user=... outcome=...` lines — is emitted),
# WARNING in stdio mode. Logs go to stderr.
MCP_LOG_LEVEL=

# Observability (DevOps metrics) — OFF by default. Leave EMPTY to disable:
# the /metrics (Prometheus), /stats (JSON), and /dashboard (HTML) routes are
# then not registered at all. Set it to a non-empty secret to enable them;
# callers must present it as `Authorization: Bearer <token>` or as the HTTP
# Basic password (any username). Metrics are in-memory and reset on restart,
# and cover only this single worker. There are no per-user Prometheus label
# series (unbounded cardinality); per-user detail is in /stats and /dashboard.
# Treat these routes as sensitive and additionally restrict them at your
# reverse proxy if the server is internet-facing. See README.md's
# "Observability" subsection. The token itself is never logged.
MCP_STATS_TOKEN=

# Context-free file uploads (drag-and-drop) — see the DevOps guide's
# "File uploads" section. Tri-state: leave EMPTY for the default (ON in http
# mode, OFF in stdio), or set a value ("1"/"true"/... vs "0"/"false"/...) to
# force it either way. When on, an interactive drop-zone UI (requires an
# MCP-Apps-capable client, e.g. Claude Desktop) sends files straight to the
# server WITHOUT passing through the model context; upload_file/upload_to_site
# then consume them by name via the `uploaded_file` parameter. Uploads live in
# server memory only, scoped per user, capped (20 files / 100 MB per user) and
# lost on restart.
MCP_ENABLE_FILE_UPLOAD=

# Max size (MB) of any single uploaded file. Positive integer. Applies to both
# transports when file upload is enabled.
MCP_UPLOAD_MAX_MB=10
